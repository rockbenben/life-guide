{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "content/src/**/*.ts",
    "content/test/**/*.ts",
    "app/src/**/*.ts",
    "app/src/**/*.tsx",
    "app/test/**/*.ts",
    "app/test/**/*.tsx",
    "schema/**/*.ts"
  ]
}
