{
  "name": "@life-guide/desktop",
  "productName": "生活指南",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "桌面端：Electron 壳，跑的是同一份 PWA 构建产物",
  "author": "benson",
  "homepage": "https://github.com/rockbenben/life-guide",
  "repository": {
    "type": "git",
    "url": "https://github.com/rockbenben/life-guide.git"
  },
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "top.045.life-guide",
    "productName": "生活指南",
    "copyright": "生活指南",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rockbenben",
        "repo": "life-guide"
      }
    ],
    "files": [
      "main.mjs",
      "preload.cjs",
      "lib/*.mjs",
      "!lib/*.test.mjs",
      "build/tray.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "app"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "LifeGuide"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.healthcare-fitness",
      "artifactName": "LifeGuide-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "executableName": "life-guide",
      "maintainer": "rockbenben <rockbenben@users.noreply.github.com>",
      "artifactName": "LifeGuide-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageName": "life-guide"
    },
    "rpm": {
      "packageName": "life-guide"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "生活指南",
      "artifactName": "LifeGuide-Setup-${version}.${ext}"
    },
    "portable": {
      "buildUniversalInstaller": false,
      "artifactName": "LifeGuide-Portable-${version}-${arch}.${ext}"
    }
  }
}
